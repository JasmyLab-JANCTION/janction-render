{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.JasmyLab-JANCTION/janction-render",
  "description": "Render Blender scenes (.blend or bpy script) on JANCTION GPUs from AI agents: previews, frames, MP4.",
  "version": "0.4.9",
  "websiteUrl": "https://render.janction.jp",
  "repository": {
    "url": "https://github.com/JasmyLab-JANCTION/janction-render",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "janction-render",
      "version": "0.4.9",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "JANCTION_RENDER_SERVER",
          "description": "Service URL (default http://127.0.0.1:8340)",
          "isRequired": false
        },
        {
          "name": "JANCTION_RENDER_API_KEY",
          "description": "API key. Optional: a temporary key is issued automatically on first use.",
          "isRequired": false,
          "isSecret": true
        }
      ],
      "registryBaseUrl": "https://pypi.org"
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://render.janction.jp/mcp"
    }
  ]
}
